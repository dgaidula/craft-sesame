{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set title = isNew ? 'New rule'|t('sesame') : rule.label %}
{% set fullPageForm = true %}
{% set crumbs = [
    { label: 'Sesame Rules'|t('sesame'), url: url('sesame/rules') },
] %}

{% block content %}
    <input type="hidden" name="action" value="sesame/rules/save">
    <input type="hidden" name="uid" value="{{ rule.uid }}">
    {{ redirectInput('sesame/rules') }}

    {{ forms.textField({
        label: 'Label'|t('sesame'),
        instructions: 'The editor-facing name for this rule (not shown to visitors).'|t('sesame'),
        id: 'label',
        name: 'label',
        value: rule.label,
        errors: rule.getErrors('label'),
        required: true,
        autofocus: true,
    }) }}

    {# Lite gates pattern rules (wildcards / whole section / whole entry type) to
       Pro — see RulesController::actionSave(). `lockPattern` is an existing Pro-
       style rule being edited on Lite (grandfathered, or after a downgrade): its
       target is shown read-only and posted unchanged via hidden inputs, so a
       password rotation or enable toggle here can't wipe or re-author it (which
       the save gate would then reject). Everywhere else the normal editor shows,
       trimmed to exact-URL only on Lite. #}
    {% set lockPattern = not isPro and not isNew and ruleIsPattern %}

    {% if lockPattern %}
        <input type="hidden" name="matchType" value="{{ rule.matchType }}">
        <input type="hidden" name="pattern" value="{{ rule.pattern }}">
        {% set protectsLabel = { uri: 'URL pattern'|t('sesame'), section: 'Section'|t('sesame'), entryType: 'Entry type'|t('sesame') }[rule.matchType] ?? rule.matchType %}
        <div class="field">
            <div class="heading"><label>{{ 'Protects'|t('sesame') }}</label></div>
            <div class="input">
                <p>{{ protectsLabel }}: <code>{{ rule.pattern }}</code></p>
                <p class="light">{{ 'This is a pattern rule — a Sesame Pro feature. You can change its password, enable/disable it, or delete it here; editing what it protects requires Sesame Pro.'|t('sesame') }}</p>
            </div>
        </div>
    {% else %}
        {{ forms.selectField({
            label: 'Protects'|t('sesame'),
            instructions: isPro
                ? 'What this rule matches. A URI glob covers any page by path; Section/Entry type cover every entry of that kind, everywhere.'|t('sesame')
                : 'What this rule matches. The free edition protects an exact URL; wildcards, whole sections, and whole entry types are a Sesame Pro feature.'|t('sesame'),
            id: 'matchType',
            name: 'matchType',
            options: isPro ? [
                { label: 'A URI (glob)'|t('sesame'), value: 'uri' },
                { label: 'A section'|t('sesame'), value: 'section' },
                { label: 'An entry type'|t('sesame'), value: 'entryType' },
            ] : [
                { label: 'A URL (exact)'|t('sesame'), value: 'uri' },
            ],
            value: rule.matchType,
            toggle: true,
            targetPrefix: '#match-',
        }) }}

        {# Only the pattern field matching the CURRENT matchType select value should
           post as `pattern` — the inputs that exist sit in the DOM at once (toggled
           by CSS via the select's fieldtoggle behavior above), so a small script
           below keeps exactly one of them named `pattern` as the select changes;
           none of them carries that name by default. On Lite only the URL input is
           rendered. #}
        <div id="match-uri"{% if rule.matchType != 'uri' %} class="hidden"{% endif %}>
            {{ forms.textField({
                label: isPro ? 'URI pattern'|t('sesame') : 'URL'|t('sesame'),
                instructions: isPro
                    ? 'The entry’s URI, or a `*` glob. Examples: `members` (exact), `members/*` (that page and everything under it).'|t('sesame')
                    : 'The entry’s exact URI, no leading slash — e.g. `members`. Wildcards (`*`) are a Sesame Pro feature.'|t('sesame'),
                id: 'pattern-uri',
                class: 'sesame-pattern-input',
                value: rule.matchType == 'uri' ? rule.pattern : '',
                placeholder: isPro ? 'members/*' : 'members',
                errors: rule.matchType == 'uri' ? rule.getErrors('pattern') : [],
            }) }}
        </div>

        {% if isPro %}
            <div id="match-section"{% if rule.matchType != 'section' %} class="hidden"{% endif %}>
                {{ forms.selectField({
                    label: 'Section'|t('sesame'),
                    instructions: 'Every entry in this section is protected, on every page it renders.'|t('sesame'),
                    id: 'pattern-section',
                    class: 'sesame-pattern-input',
                    options: [{ label: 'Select a section…'|t('sesame'), value: '' }]|merge(sectionOptions),
                    value: rule.matchType == 'section' ? rule.pattern : '',
                    errors: rule.matchType == 'section' ? rule.getErrors('pattern') : [],
                }) }}
            </div>

            <div id="match-entryType"{% if rule.matchType != 'entryType' %} class="hidden"{% endif %}>
                {{ forms.selectField({
                    label: 'Entry type'|t('sesame'),
                    instructions: 'Every entry of this type is protected, regardless of which section it lives in.'|t('sesame'),
                    id: 'pattern-entryType',
                    class: 'sesame-pattern-input',
                    options: [{ label: 'Select an entry type…'|t('sesame'), value: '' }]|merge(entryTypeOptions),
                    value: rule.matchType == 'entryType' ? rule.pattern : '',
                    errors: rule.matchType == 'entryType' ? rule.getErrors('pattern') : [],
                }) }}
            </div>
        {% endif %}
    {% endif %}

    <hr>

    {{ forms.passwordField({
        label: 'Password'|t('sesame'),
        instructions: isNew
            ? 'The password visitors must enter to view any page this rule protects.'|t('sesame')
            : 'Leave blank to keep the current password.'|t('sesame'),
        id: 'password',
        name: 'password',
        value: '',
        autocomplete: false,
        required: isNew,
        errors: rule.getErrors('secret'),
    }) }}

    {% if not isNew %}
        {% if codeOneMode == 'encrypt' %}
            <div class="field">
                <button type="button" class="btn" id="sesame-reveal-btn" data-uid="{{ rule.uid }}">{{ 'Reveal current password'|t('sesame') }}</button>
                <p id="sesame-reveal-result" class="light" style="margin-top:6px;"></p>
            </div>
        {% else %}
            <p class="light">{{ '•••• set — this password is bcrypt-hashed and can’t be displayed. Enter a new one to replace it.'|t('sesame') }}</p>
        {% endif %}

        <div class="field">
            <div class="heading">
                <label>{{ 'Revoke access'|t('sesame') }}</label>
                <div class="instructions">
                    <p>{{ 'Immediately signs out everyone currently unlocked and kills every shareable link for this rule. The password stays the same — visitors just have to enter it again.'|t('sesame') }}</p>
                </div>
            </div>
            <button type="button" class="btn" id="sesame-revoke-btn" data-uid="{{ rule.uid }}">{{ 'Revoke all access now'|t('sesame') }}</button>
            <p id="sesame-revoke-result" class="light" style="margin-top:6px;"></p>
        </div>
    {% endif %}

    <hr>

    {{ forms.textareaField({
        label: 'Custom message'|t('sesame'),
        instructions: 'Shown on the password screen instead of the default prompt. Leave blank for “This page is protected. Enter the password to continue.”'|t('sesame'),
        id: 'message',
        name: 'message',
        value: rule.message,
        rows: 2,
    }) }}

    {{ forms.textField({
        label: 'Template override'|t('sesame'),
        instructions: 'Advanced. A site template path to render instead of the default password screen for this rule, e.g. `sesame/gate/challenge-members`.'|t('sesame'),
        id: 'templateOverride',
        name: 'templateOverride',
        value: rule.templateOverride,
    }) }}

    {{ forms.lightswitchField({
        label: 'Enabled'|t('sesame'),
        instructions: 'Off leaves the rule saved but inactive — matching pages render normally, unprotected.'|t('sesame'),
        id: 'enabled',
        name: 'enabled',
        on: rule.enabled,
    }) }}

    {% if isPro %}
        <hr>

        <div class="field">
            <div class="heading">
                <label>{{ 'Schedule'|t('sesame') }} <sup>PRO</sup></label>
                <div class="instructions">
                    <p>{{ 'Protect this rule’s pages only within a time window. Leave a field blank for “no bound”: set only Lock at to protect from that time on (e.g. an embargo that goes live later stays open until then); set only Unlock at to protect until then and open the page afterwards; set both for a fixed window. Leave both blank to protect always. Evaluated in the site’s server time.'|t('sesame') }}</p>
                </div>
            </div>
        </div>

        {{ forms.dateTimeField({
            label: 'Lock at'|t('sesame'),
            instructions: 'Start protecting at this time. Blank = protected from the start.'|t('sesame'),
            id: 'protectFrom',
            name: 'protectFrom',
            value: protectFromDate,
            errors: rule.getErrors('protectFrom'),
        }) }}

        {{ forms.dateTimeField({
            label: 'Unlock at'|t('sesame'),
            instructions: 'Stop protecting at this time — the page is public afterwards. Blank = never expires.'|t('sesame'),
            id: 'protectUntil',
            name: 'protectUntil',
            value: protectUntilDate,
            errors: rule.getErrors('protectUntil'),
        }) }}

        {{ forms.lightswitchField({
            label: ('Remember me'|t('sesame') ~ ' <sup>PRO</sup>')|raw,
            instructions: 'Let a visitor check “Remember me” on the password screen so their unlock survives beyond the browser session, for Settings → General → Remember-me duration.'|t('sesame'),
            id: 'rememberMe',
            name: 'rememberMe',
            on: rule.rememberMe,
        }) }}

        <hr>

        <div class="field">
            <div class="heading">
                <label>{{ 'Password-screen branding'|t('sesame') }} <sup>PRO</sup></label>
                <div class="instructions">
                    <p>{{ 'Override the site-wide defaults (Sesame → Branding) for this rule’s password screen. Leave a field blank to inherit. The per-rule intro is the Custom message above.'|t('sesame') }}</p>
                </div>
            </div>
        </div>

        {{ forms.textField({
            label: 'Screen heading'|t('sesame'),
            instructions: 'The small label above the prompt. Blank = inherit.'|t('sesame'),
            id: 'brandHeading',
            name: 'brandHeading',
            value: rule.brandHeading,
        }) }}

        {{ forms.textField({
            label: 'Accent colour'|t('sesame'),
            instructions: 'A CSS colour (`#2f6f7e`, a keyword, or `rgb()`/`hsl()`). Blank = inherit.'|t('sesame'),
            id: 'brandAccent',
            name: 'brandAccent',
            value: rule.brandAccent,
            placeholder: '#2f6f7e',
        }) }}

        {{ forms.elementSelectField({
            label: 'Logo'|t('sesame'),
            instructions: 'Shown in place of the padlock icon. None = inherit.'|t('sesame'),
            id: 'brandLogoId',
            name: 'brandLogoId',
            elementType: 'craft\\elements\\Asset',
            limit: 1,
            elements: brandLogo ? [brandLogo] : [],
            criteria: { kind: ['image'] },
        }) }}

        {% if not isNew %}
            <div class="field">
                <div class="heading">
                    <label>{{ 'Shareable link'|t('sesame') }} <sup>PRO</sup></label>
                    <div class="instructions">
                        <p>{{ 'Mints a one-click link for the primary code (the Password above) that unlocks this rule for whoever opens it — no password needed. Good for emailing someone a link instead of a shared password. Each named code below has its own link.'|t('sesame') }}</p>
                    </div>
                </div>
                <button type="button" class="btn" id="sesame-link-btn" data-uid="{{ rule.uid }}">{{ 'Copy shareable link'|t('sesame') }}</button>
                <p id="sesame-link-result" class="light" style="margin-top:6px;"></p>
            </div>
        {% endif %}
    {% endif %}

    {# Named codes — codes 2..N (the primary code is the Password field above).
       Listed on EVERY edition (Fix 2) so a site that dropped from Pro to Lite can
       still see and revoke/delete codes it made on Pro; ADDING a code and
       relabel/expiry stay Pro (gated below and in the controller). #}
    {% if not isNew %}
        <div class="field" id="sesame-codes" data-uid="{{ rule.uid }}">
                <div class="heading">
                    <label>{{ 'Named codes'|t('sesame') }}{% if isPro %} <sup>PRO</sup>{% endif %}</label>
                    <div class="instructions">
                        <p>{{ 'Extra credentials beyond the primary password — each with its own label, optional expiry, individual revoke, and shareable link. Revoking or expiring one cuts off just its holders; the primary password still works. Up to 25 codes per rule.'|t('sesame') }}</p>
                    </div>
                </div>

                {% if additionalCodes|length %}
                    <table class="data fullwidth" style="margin-bottom:12px;">
                        <thead>
                            <tr>
                                <th scope="col">{{ 'Label'|t('sesame') }}</th>
                                <th scope="col">{{ 'Expires'|t('sesame') }}</th>
                                <th scope="col">{{ 'Status'|t('sesame') }}</th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for c in additionalCodes %}
                                <tr data-code="{{ c.uid }}">
                                    <td><input type="text" class="text sesame-code-label" value="{{ c.label }}" placeholder="{{ 'Label'|t('sesame') }}"{% if not isPro %} readonly{% endif %}></td>
                                    <td><input type="date" class="text sesame-code-exp" value="{{ c.expiresAt ? c.expiresAt|date('Y-m-d') : '' }}"{% if not isPro %} disabled{% endif %}></td>
                                    <td>
                                        {% set statusClass = { active: 'enabled', revoked: 'off', expired: 'pending' }[c.status] ?? '' %}
                                        <span class="status {{ statusClass }}"></span>{{ c.status|t('sesame') }}
                                    </td>
                                    <td>
                                        {% if isPro %}<button type="button" class="btn small sesame-code-save">{{ 'Save'|t('sesame') }}</button>{% endif %}
                                        {% if c.canReveal %}<button type="button" class="btn small sesame-code-reveal">{{ 'Reveal'|t('sesame') }}</button>{% endif %}
                                        {% if isPro %}<button type="button" class="btn small sesame-code-link">{{ 'Copy link'|t('sesame') }}</button>{% endif %}
                                        {% if c.status == 'active' %}<button type="button" class="btn small sesame-code-revoke">{{ 'Revoke'|t('sesame') }}</button>{% endif %}
                                        <button type="button" class="btn small sesame-code-delete">{{ 'Delete'|t('sesame') }}</button>
                                        <span class="sesame-code-result light" style="margin-left:6px;"></span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}

                {% if isPro %}
                    <div class="sesame-addcode">
                        <input type="text" id="sesame-newcode-label" class="text" placeholder="{{ 'Label (e.g. District A)'|t('sesame') }}" style="max-width:180px;">
                        <input type="password" id="sesame-newcode-pw" class="text" placeholder="{{ 'Password'|t('sesame') }}" autocomplete="new-password" style="max-width:160px;">
                        <input type="date" id="sesame-newcode-exp" class="text" title="{{ 'Optional expiry'|t('sesame') }}">
                        <button type="button" class="btn" id="sesame-addcode-btn">{{ 'Add code'|t('sesame') }}</button>
                        <span id="sesame-addcode-result" class="light" style="margin-left:6px;"></span>
                    </div>
                {% elseif not additionalCodes|length %}
                    <p class="light">{{ 'Multiple codes per rule are a Sesame Pro feature.'|t('sesame') }}</p>
                {% endif %}
        </div>
    {% endif %}
{% endblock %}

{% js %}
(function () {
    var select = document.getElementById('matchType');
    var inputs = {
        uri: document.getElementById('pattern-uri'),
        section: document.getElementById('pattern-section'),
        entryType: document.getElementById('pattern-entryType'),
    };

    function syncPatternName() {
        var active = select.value;
        Object.keys(inputs).forEach(function (key) {
            if (inputs[key]) {
                inputs[key].name = key === active ? 'pattern' : '';
            }
        });
    }

    if (select) {
        syncPatternName();
        select.addEventListener('change', syncPatternName);
    }
})();

document.addEventListener('click', function (e) {
    var btn = e.target.closest('#sesame-reveal-btn');
    if (!btn) {
        return;
    }
    e.preventDefault();
    var result = document.getElementById('sesame-reveal-result');

    var doReveal = function () {
        result.textContent = {{ 'Revealing…'|t('sesame')|json_encode|raw }};

        var body = new FormData();
        body.append('uid', btn.dataset.uid);
        body.append({{ craft.app.config.general.csrfTokenName|json_encode|raw }}, {{ craft.app.request.csrfToken|json_encode|raw }});

        fetch({{ actionUrl('sesame/rules/reveal-password')|json_encode|raw }}, {
            method: 'POST',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: body,
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                result.textContent = data.password
                    ? {{ 'Current password: '|t('sesame')|json_encode|raw }} + data.password
                    : {{ 'This password is written-only and can’t be revealed.'|t('sesame')|json_encode|raw }};
            })
            .catch(function () {
                result.textContent = {{ 'Couldn’t reveal the password.'|t('sesame')|json_encode|raw }};
            });
    };

    // Revealing a secret requires an elevated (re-authenticated) session — the
    // manager shows the password prompt when needed, then runs the callback.
    if (window.Craft && Craft.elevatedSessionManager) {
        Craft.elevatedSessionManager.requireElevatedSession(doReveal);
    } else {
        doReveal();
    }
});

document.addEventListener('click', function (e) {
    var btn = e.target.closest('#sesame-link-btn');
    if (!btn) {
        return;
    }
    e.preventDefault();
    var result = document.getElementById('sesame-link-result');
    result.textContent = {{ 'Minting…'|t('sesame')|json_encode|raw }};

    var body = new FormData();
    body.append('uid', btn.dataset.uid);
    body.append({{ craft.app.config.general.csrfTokenName|json_encode|raw }}, {{ craft.app.request.csrfToken|json_encode|raw }});

    fetch({{ actionUrl('sesame/rules/mint-link')|json_encode|raw }}, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: body,
    })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data.error || !data.url) {
                result.textContent = data.error || {{ 'Couldn’t mint a link.'|t('sesame')|json_encode|raw }};
                return;
            }
            var showResult = function (copied) {
                result.textContent = (copied ? {{ 'Copied: '|t('sesame')|json_encode|raw }} : {{ 'Link: '|t('sesame')|json_encode|raw }}) + data.url;
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(data.url).then(function () { showResult(true); }).catch(function () { showResult(false); });
            } else {
                showResult(false);
            }
        })
        .catch(function () {
            result.textContent = {{ 'Couldn’t mint a link.'|t('sesame')|json_encode|raw }};
        });
});

document.addEventListener('click', function (e) {
    var btn = e.target.closest('#sesame-revoke-btn');
    if (!btn) {
        return;
    }
    e.preventDefault();
    if (!window.confirm({{ 'Sign out everyone and kill every shareable link for this rule? The password is unchanged.'|t('sesame')|json_encode|raw }})) {
        return;
    }
    var result = document.getElementById('sesame-revoke-result');
    result.textContent = {{ 'Revoking…'|t('sesame')|json_encode|raw }};

    var body = new FormData();
    body.append('uid', btn.dataset.uid);
    body.append({{ craft.app.config.general.csrfTokenName|json_encode|raw }}, {{ craft.app.request.csrfToken|json_encode|raw }});

    fetch({{ actionUrl('sesame/rules/revoke')|json_encode|raw }}, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: body,
    })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            result.textContent = data.ok
                ? {{ 'All access revoked. Everyone must re-enter the password.'|t('sesame')|json_encode|raw }}
                : (data.error || {{ 'Couldn’t revoke access.'|t('sesame')|json_encode|raw }});
        })
        .catch(function () {
            result.textContent = {{ 'Couldn’t revoke access.'|t('sesame')|json_encode|raw }};
        });
});

// --- PRO: named-code management ---
(function () {
    var wrap = document.getElementById('sesame-codes');
    if (!wrap) {
        return;
    }
    var ruleUid = wrap.dataset.uid;
    var CSRF_NAME = {{ craft.app.config.general.csrfTokenName|json_encode|raw }};
    var CSRF = {{ craft.app.request.csrfToken|json_encode|raw }};
    var URLS = {
        add: {{ actionUrl('sesame/rules/add-code')|json_encode|raw }},
        update: {{ actionUrl('sesame/rules/update-code')|json_encode|raw }},
        revoke: {{ actionUrl('sesame/rules/revoke-code')|json_encode|raw }},
        del: {{ actionUrl('sesame/rules/delete-code')|json_encode|raw }},
        link: {{ actionUrl('sesame/rules/mint-link')|json_encode|raw }},
        reveal: {{ actionUrl('sesame/rules/reveal-password')|json_encode|raw }}
    };
    function post(url, params) {
        var body = new FormData();
        body.append(CSRF_NAME, CSRF);
        Object.keys(params).forEach(function (k) { body.append(k, params[k]); });
        return fetch(url, { method: 'POST', headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: body })
            .then(function (r) { return r.json(); });
    }
    function rowOf(el) { return el.closest('tr[data-code]'); }
    function resultEl(row) { return row.querySelector('.sesame-code-result'); }

    // Add a code (the button is Pro-only, so it may be absent on Lite)
    var addBtn = document.getElementById('sesame-addcode-btn');
    if (addBtn) addBtn.addEventListener('click', function () {
        var out = document.getElementById('sesame-addcode-result');
        var pw = document.getElementById('sesame-newcode-pw').value;
        if (!pw) { out.textContent = {{ 'Enter a password for the new code.'|t('sesame')|json_encode|raw }}; return; }
        out.textContent = {{ 'Adding…'|t('sesame')|json_encode|raw }};
        post(URLS.add, {
            uid: ruleUid,
            password: pw,
            label: document.getElementById('sesame-newcode-label').value,
            expiresAt: document.getElementById('sesame-newcode-exp').value
        }).then(function (d) {
            if (d.ok) { window.location.reload(); }
            else { out.textContent = d.error || {{ 'Couldn’t add the code.'|t('sesame')|json_encode|raw }}; }
        }).catch(function () { out.textContent = {{ 'Couldn’t add the code.'|t('sesame')|json_encode|raw }}; });
    });

    // Delegated row actions
    wrap.addEventListener('click', function (e) {
        var btn = e.target;
        var row = rowOf(btn);
        if (!row) { return; }
        var codeId = row.dataset.code;
        var out = resultEl(row);

        if (btn.classList.contains('sesame-code-save')) {
            var expInput = row.querySelector('.sesame-code-exp');
            // Clearing an expiry re-validates everyone who held the code — warn.
            if (expInput.defaultValue && !expInput.value &&
                !window.confirm({{ 'Clearing this code’s expiry re-validates everyone who held it. Continue?'|t('sesame')|json_encode|raw }})) { return; }
            out.textContent = {{ 'Saving…'|t('sesame')|json_encode|raw }};
            post(URLS.update, { codeId: codeId, label: row.querySelector('.sesame-code-label').value, expiresAt: expInput.value })
                .then(function (d) { d.ok ? window.location.reload() : (out.textContent = d.error || {{ 'Couldn’t save.'|t('sesame')|json_encode|raw }}); });
        } else if (btn.classList.contains('sesame-code-revoke')) {
            // The primary password (the Password field above) is not in this list
            // and always keeps working, so revoking a listed code never fully
            // locks the rule; still confirm that this code's holders are cut off.
            if (!window.confirm({{ 'Revoke this code? Everyone holding it, and its links, are cut off. (The rule’s primary password still works.)'|t('sesame')|json_encode|raw }})) { return; }
            post(URLS.revoke, { codeId: codeId }).then(function (d) { d.ok ? window.location.reload() : (out.textContent = d.error || 'Error'); });
        } else if (btn.classList.contains('sesame-code-delete')) {
            if (!window.confirm({{ 'Delete this code for good?'|t('sesame')|json_encode|raw }})) { return; }
            post(URLS.del, { codeId: codeId }).then(function (d) { d.ok ? window.location.reload() : (out.textContent = d.error || {{ 'Couldn’t delete.'|t('sesame')|json_encode|raw }}); });
        } else if (btn.classList.contains('sesame-code-link')) {
            out.textContent = {{ 'Minting…'|t('sesame')|json_encode|raw }};
            post(URLS.link, { uid: ruleUid, codeId: codeId }).then(function (d) {
                if (d.error || !d.url) { out.textContent = d.error || {{ 'Couldn’t mint a link.'|t('sesame')|json_encode|raw }}; return; }
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(d.url).then(function () { out.textContent = {{ 'Copied: '|t('sesame')|json_encode|raw }} + d.url; }, function () { out.textContent = d.url; });
                } else { out.textContent = d.url; }
            });
        } else if (btn.classList.contains('sesame-code-reveal')) {
            var doReveal = function () {
                out.textContent = {{ 'Revealing…'|t('sesame')|json_encode|raw }};
                post(URLS.reveal, { uid: ruleUid, codeId: codeId }).then(function (d) {
                    out.textContent = d.password ? ({{ 'Password: '|t('sesame')|json_encode|raw }} + d.password) : {{ 'Written-only — can’t be shown.'|t('sesame')|json_encode|raw }};
                });
            };
            if (window.Craft && Craft.elevatedSessionManager) { Craft.elevatedSessionManager.requireElevatedSession(doReveal); }
            else { doReveal(); }
        }
    });
})();
{% endjs %}
